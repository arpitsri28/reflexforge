+"""Static-incumbent token-budget sensitivity; free preparation/preflight by default.
+
+Paid execution requires an explicit run subcommand and one split. This module
+uses the existing BenchmarkRunner, run_worker, Evaluator and shared UsageLedger;
+it does not implement another worker/evaluator or change any incumbent file.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import sqlite3
+import sys
+import tempfile
+import uuid
+from decimal import Decimal
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+
+REPO = Path(__file__).resolve().parents[2]
+OUTPUT = Path(__file__).resolve().parent / "budget-sensitivity-2026-11-11"
+PLAN = OUTPUT / "plan.json"
+BASELINE = Path(__file__).resolve().parent / "baseline-repeat-2026-11-11/isolated-cli"
+GROUPS = {"train": ["task_101", "task_102", "task_104"], "dev": ["task_108"]}
+CAPS = {"max_tokens": 160000, "max_api_calls": 180, "max_usd": 0.40}
+
+
+def load(path):
+    return json.loads(path.read_text())
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def settings(plan, split):
+    from reflexforge.benchmark.settings import BenchmarkSettings
+
+    return BenchmarkSettings(
+        suite="repobench",
+        split=split,
+        conditions=["static"],
+        attempts=1,
+        worker_model=plan["model"],
+        meta_model=plan["model"],
+        worker_prices=tuple(plan["prices"]),
+        worker_temperature=plan["sampling"]["temperature"],
+        worker_reasoning_effort=plan["sampling"]["reasoning_effort"],
+        seed=plan["seed"],
+        run_budget=plan["run_budget"],
+        **plan["caps"],
+    )
+
+
+def prepare(plan_path=PLAN):
+    if plan_path.exists():
+        raise RuntimeError("Plan already exists; preparation never overwrites it")
+    prior = load(BASELINE / "roots.json")
+    summary = load(BASELINE / "repeat-evidence/repeat-summary.json")
+    baseline_upper = sum(Decimal(r["usd"]) for r in summary["root_ledgers"])
+    assert baseline_upper + Decimal(str(CAPS["max_usd"])) <= Decimal("1.00")
+    root = Path(
+        tempfile.mkdtemp(prefix="reflexforge-token-sensitivity-2026-11-11-", dir="/private/tmp")
+    )
+    sources = [REPO / "suites/repobench/benchmark/manifest.json"]
+    for split, ids in GROUPS.items():
+        for task in ids:
+            sources.extend(
+                p
+                for p in sorted((REPO / "suites/repobench/tasks" / split / task).rglob("*"))
+                if p.is_file()
+            )
+            sources.append(
+                REPO / f"artifacts/benchmark/repobench/qa/{prior['bank_version']}/{task}.json"
+            )
+    copies = []
+    for source in sources:
+        assert source.is_file() and not source.is_symlink()
+        destination = root / source.relative_to(REPO)
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+        assert sha(source) == sha(destination)
+        copies.append({"source": str(source), "copy": str(destination), "sha256": sha(source)})
+    run_budget = dict(prior["recorded_settings"]["run_budget"])
+    run_budget["max_tokens"] = 40000
+    plan = {
+        "study_id": uuid.uuid4().hex,
+        "kind": "budget_sensitivity_not_candidate",
+        "root": str(root),
+        "groups": GROUPS,
+        "frozen_config": prior["frozen_config"],
+        "source_config_hash": prior["frozen_config_hash"],
+        "bank_version": prior["bank_version"],
+        "image_id": prior["image_id"],
+        "model": prior["recorded_settings"]["worker_model"],
+        "prices": prior["recorded_settings"]["worker_prices"],
+        "sampling": {
+            "temperature": prior["recorded_settings"]["worker_temperature"],
+            "reasoning_effort": prior["recorded_settings"]["worker_reasoning_effort"],
+        },
+        "seed": prior["recorded_settings"]["seed"],
+        "run_budget": run_budget,
+        "baseline_budget": prior["recorded_settings"]["run_budget"],
+        "caps": CAPS,
+        "baseline_ledger_usd_upper_bound": str(baseline_upper),
+        "copies": copies,
+        "incumbent_files": {
+            str(p): sha(p) for p in sorted(Path(prior["frozen_config"]).rglob("*")) if p.is_file()
+        },
+    }
+    verify_inputs(plan)
+    plan_path.parent.mkdir(parents=True, exist_ok=True)
+    plan_path.write_text(json.dumps(plan, indent=2) + "\n")
+    rows = [
+        "# Sensitivity-study byte-identical inputs",
+        "",
+        "| Original | Original SHA-256 | Copy SHA-256 |",
+        "| --- | --- | --- |",
+    ]
+    rows.extend(f"| {r['source']} | {r['sha256']} | {sha(Path(r['copy']))} |" for r in copies)
+    (plan_path.parent / "copy-hashes.md").write_text("\n".join(rows) + "\n")
+    return plan
+
+
+def verify_inputs(plan):
+    from reflexforge.benchmark.manifest import load_manifest, resolve_entry
+    from reflexforge.schema import Budget
+    from reflexforge.worker.agent import effective_budget
+    from reflexforge.worker.config import AgentConfig
+
+    assert set(plan["groups"]) == {"train", "dev"} and all(
+        set(ids) <= set(GROUPS[split]) for split, ids in plan["groups"].items()
+    )
+    assert plan["run_budget"] == {**plan["baseline_budget"], "max_tokens": 40000}
+    assert plan["caps"] == CAPS
+    for row in plan["copies"]:
+        assert sha(Path(row["source"])) == sha(Path(row["copy"])) == row["sha256"]
+    for name, value in plan["incumbent_files"].items():
+        assert sha(Path(name)) == value
+    assert AgentConfig.load(Path(plan["frozen_config"])).version == plan["source_config_hash"]
+    dataset = Path(plan["root"]) / "suites/repobench"
+    manifest = load_manifest(dataset, plan["bank_version"])
+    for split, ids in plan["groups"].items():
+        entries = [e for e in manifest.entries if e.id in ids and e.split == split]
+        assert len(entries) == len(ids)
+        for e in entries:
+            task, _, _ = resolve_entry(dataset, e)
+            assert (
+                effective_budget(Budget(**plan["run_budget"]), task.budget).model_dump()
+                == plan["run_budget"]
+            )
+            qa = load(
+                Path(plan["root"])
+                / f"artifacts/benchmark/repobench/qa/{manifest.version}/{e.id}.json"
+            )
+            assert (
+                qa["valid"]
+                and qa["manifest_hash"] == manifest.version
+                and qa["image_id"] == plan["image_id"]
+            )
+            assert qa["source_hash"] == e.source_hash and qa["reference_hash"] == e.reference_hash
+    assert not (dataset / "tasks/test").exists()
+
+
+def ledger_status(plan):
+    path = Path(plan["root"]) / "artifacts/budget-sensitivity-ledger/optimization.sqlite3"
+    if not path.exists():
+        return {"api_calls": 0, "tokens": 0, "usd_upper_bound": "0", "uncertain": False}
+    db = sqlite3.connect(path.as_uri() + "?mode=ro", uri=True)
+    rows = db.execute(
+        "SELECT state,calls,tokens,usd FROM api_usage WHERE experiment_id=?", (plan["study_id"],)
+    ).fetchall()
+    db.close()
+    return {
+        "api_calls": sum(r[1] for r in rows),
+        "tokens": sum(r[2] for r in rows),
+        "usd_upper_bound": str(sum((Decimal(str(r[3])) for r in rows), Decimal(0))),
+        "uncertain": any(r[0] in ("reserved", "unknown", "overrun") for r in rows),
+    }
+
+
+def preflight(plan, split=None):
+    from reflexforge.benchmark.settings import preflight as bounds
+
+    verify_inputs(plan)
+    used = ledger_status(plan)
+    assert not used["uncertain"], "Uncertain usage blocks further study calls"
+    selected = [split] if split else list(plan["groups"])
+    output = {
+        "kind": plan["kind"],
+        "paid_requests_made": False,
+        "root": plan["root"],
+        "study_id": plan["study_id"],
+        "tasks": {s: plan["groups"][s] for s in selected},
+        "only_changed_worker_field": {"max_tokens": {"before": 24000, "after": 40000}},
+        "worker_budget": plan["run_budget"],
+        "model": plan["model"],
+        "image_id": plan["image_id"],
+        "bank_version": plan["bank_version"],
+        "frozen_config": plan["frozen_config"],
+        "all_copy_hashes_match": True,
+        "existing_qa_matches": True,
+        "shared_ledger_used": used,
+        "bounds": bounds(
+            settings(plan, selected[0]), sum(len(plan["groups"][s]) for s in selected)
+        ),
+        "baseline_plus_study_cap_usd_upper_bound": str(
+            Decimal(plan["baseline_ledger_usd_upper_bound"]) + Decimal(str(plan["caps"]["max_usd"]))
+        ),
+        "caveats": [
+            "This is a budget-sensitivity study, not a candidate.",
+            "One new attempt per selected task cannot establish a causal cap effect.",
+            "Step/time limits stay unchanged and may bind next.",
+            "Actual spending forecast is not available; USD bound is ledger pricing, not an invoice.",
+        ],
+    }
+    if split:
+        output["plan_sha256"] = hashlib.sha256(
+            json.dumps(plan, sort_keys=True).encode()
+        ).hexdigest()
+        (Path(plan["root"]) / f"{split}-preflight.json").write_text(
+            json.dumps(output, indent=2) + "\n"
+        )
+    return output
+
+
+def run_split(plan, split):
+    import openai
+
+    from reflexforge.benchmark.runner import BenchmarkRunner
+    from reflexforge.meta.budget import UsageLedger
+    from reflexforge.meta.state import OptimizationState
+    from reflexforge.settings import load_environment
+
+    load_environment()
+    verify_inputs(plan)
+    assert not ledger_status(plan)["uncertain"]
+    receipt = load(Path(plan["root"]) / f"{split}-preflight.json")
+    assert (
+        receipt["plan_sha256"]
+        == hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest()
+    )
+    assert receipt["shared_ledger_used"] == ledger_status(plan), (
+        "Refresh the free preflight after any ledger change"
+    )
+    assert os.getenv("OPENAI_API_KEY"), "OPENAI_API_KEY is required"
+    os.environ["REFLEXFORGE_IMAGE"] = plan["image_id"]
+    os.environ["REFLEXFORGE_INPUT_PRICE"] = str(plan["prices"][0])
+    os.environ["REFLEXFORGE_OUTPUT_PRICE"] = str(plan["prices"][1])
+    # A split is never silently replayed. Its marker is outside original artifacts.
+    marker = Path(plan["root"]) / f"{split}-invocation.json"
+    with marker.open("x") as f:
+        json.dump({"split": split, "study_id": plan["study_id"], "kind": plan["kind"]}, f)
+    configured = settings(plan, split)
+    state = OptimizationState(Path(plan["root"]) / "artifacts/budget-sensitivity-ledger")
+    with state.connect() as db:
+        existing = db.execute(
+            "SELECT id FROM experiments WHERE id=?", (plan["study_id"],)
+        ).fetchone()
+        if existing is None:
+            db.execute(
+                "INSERT INTO experiments VALUES (?,0,?,?)",
+                (
+                    plan["study_id"],
+                    json.dumps({"kind": plan["kind"], "caps": plan["caps"]}),
+                    "budget_sensitivity",
+                ),
+            )
+    ledger = UsageLedger(state, plan["study_id"], configured)
+    # No worker/evaluator injection: exactly the CLI's internal execution path.
+    with openai.OpenAI(max_retries=0) as client:
+        result = BenchmarkRunner(
+            Path(plan["root"]), configured, client=client, shared_ledger=ledger
+        ).run(
+            task_ids=plan["groups"][split],
+            config_path=Path(plan["frozen_config"]),
+            bank_version=plan["bank_version"],
+        )
+    verify_inputs(plan)
+    result["study_ledger"] = ledger_status(plan)
+    return result
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("operation", choices=("prepare", "preflight", "run"))
+    p.add_argument("--split", choices=("train", "dev"))
+    args = p.parse_args()
+    if args.operation == "prepare":
+        data = preflight(prepare())
+    elif args.operation == "preflight":
+        data = preflight(load(PLAN), args.split)
+    else:
+        if args.split is None:
+            p.error("run requires exactly one split; train and dev are separate paid invocations")
+        data = run_split(load(PLAN), args.split)
+    print(json.dumps(data, indent=2))
